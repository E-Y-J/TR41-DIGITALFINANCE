# ============================================
# Backend Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env file!
# ============================================

# Flask Configuration
FLASK_APP=app:create_app
FLASK_ENV=development
DEV_IMPERSONATION=true
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-change-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/digital_finance_db

# Auth0 Configuration (REQUIRED)
# Get these from Auth0 Dashboard > Applications > Your API
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=your-api-identifier
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_ALGORITHMS=RS256

# Redis (for caching & rate limiting)
# REDIS_URL=redis://localhost:6379/0-enable when ready

# Sentry (monitoring - optional)
# SENTRY_DSN=- add your Sentry DSN here

# CORS (Frontend URL)
# FRONTEND_URL=http://localhost:5173

# # AI Model Configuration
# AI_MODEL_PATH=app/ai/model_store/
# AI_CONFIDENCE_THRESHOLD=0.7

# Google Gemini API (for AI fallback categorization & chat)
# Get free API key from: https://makersuite.google.com/app/apikey
# Free tier: 15 requests/min, 1000 requests/day
GEMINI_API_KEY=your-gemini-api-key-here

# AI Models (auto-download HuggingFace models on first use)
# MiniLM: sentence-transformers/multi-qa-MiniLM-L6-cos-v1 (intent classifier)
# DistilBERT: Fine-tuned model in app/ai/transaction_classification_model/ (shared separately)
# Run: python tools/download_model.py --check (to verify model status)

# PayPal Sandbox (Stretch Goal)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
