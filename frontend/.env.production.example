# =====================
# AUTH0 CONFIGURATION
# =====================
# [REQUIRED] Must match backend Auth0 settings
VITE_AUTH0_DOMAIN=dev-2d371r8njde648mh.us.auth0.com
VITE_AUTH0_CLIENT_ID=Xmf7EN2wO4jhTjJN1T2U1ZDgJidWI32A
VITE_AUTH0_AUDIENCE=https://api.digitalfinance.local

# =====================
# API CONFIGURATION
# =====================
# [REQUIRED] Your production backend URL (VPS with domain or IP)
# Examples:
#   With domain: https://api.yoursite.com
#   With IP: http://YOUR_VPS_IP:8000
# NOTE: Do NOT include /api suffix - it's added automatically
VITE_API_URL=https://your-vps-domain-or-ip:8000
