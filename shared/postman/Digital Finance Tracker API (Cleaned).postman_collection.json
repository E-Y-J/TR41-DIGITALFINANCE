			"name": "Authentication",
			"item": [
				{
					"name": "Auth0 Callback-Authenticated",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Authenticated /api/auth/callback - Post-response tests\r",
									"\r",
									"// Basic status + content-type checks\r",
									"pm.test('Status code is 200', () => {\r",
									"  pm.response.to.have.status(200);\r",
									"});\r",
									"pm.test('Content-Type is application/json', () => {\r",
									"  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');\r",
									"});\r",
									"\r",
									"// Parse response once and fail fast if invalid JSON\r",
									"let json;\r",
									"let parsed = true;\r",
									"try {\r",
									"  json = pm.response.json();\r",
									"} catch (e) {\r",
									"  parsed = false;\r",
									"  pm.test('Response is valid JSON', () => {\r",
									"    throw new Error('Response is not valid JSON');\r",
									"  });\r",
									"}\r",
									"\r",
									"// If parsing failed, skip the rest\r",
									"if (!parsed) {\r",
									"  // Stop here — other tests depend on valid JSON\r",
									"  return;\r",
									"}\r",
									"\r",
									"// Standard envelope checks\r",
									"pm.test('Response has success, data, message', () => {\r",
									"  pm.expect(json).to.have.property('success');\r",
									"  pm.expect(json).to.have.property('data');\r",
									"  pm.expect(json).to.have.property('message');\r",
									"});\r",
									"\r",
									"// Check success is true\r",
									"pm.test('success is true', () => {\r",
									"  pm.expect(json.success).to.be.true;\r",
									"});\r",
									"\r",
									"// Ensure data is an object (user)\r",
									"pm.test('data is an object', () => {\r",
									"  pm.expect(json.data).to.be.an('object');\r",
									"});\r",
									"\r",
									"// Basic user shape checks (safe because data is object)\r",
									"pm.test('User object contains id, auth0_id, email', () => {\r",
									"  const user = json.data;\r",
									"  pm.expect(user).to.have.property('id');\r",
									"  pm.expect(user).to.have.property('auth0_id');\r",
									"  pm.expect(user).to.have.property('email');\r",
									"});\r",
									"\r",
									"// Validate id looks like a UUID (RFC4122-like)\r",
									"pm.test('User id looks like a UUID', () => {\r",
									"  const id = (json.data && json.data.id) || '';\r",
									"  pm.expect(id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);\r",
									"});\r",
									"\r",
									"// Conditional email checks:\r",
									"// - if expectedUserEmail is set in env, assert equality\r",
									"// - else if bearerToken is present, assert an email string is present\r",
									"// - else allow email to be absent (useful for test tokens / CI)\r",
									"const expectedEmail = pm.environment.get('expectedUserEmail');\r",
									"const bearer = pm.environment.get('bearerToken');\r",
									"\r",
									"if (expectedEmail) {\r",
									"  pm.test('email matches expected', () => {\r",
									"    pm.expect(json.data.email).to.eql(expectedEmail);\r",
									"  });\r",
									"} else if (bearer) {\r",
									"  pm.test('email present in token/profile', () => {\r",
									"    pm.expect(json.data.email).to.be.a('string');\r",
									"  });\r",
									"} else {\r",
									"  pm.test('email may be absent in test token (or no token provided)', () => {\r",
									"    pm.expect([null, undefined, '']).to.include(json.data.email) || pm.expect(json.data.email).to.be.a('string');\r",
									"  });\r",
									"}\r",
									"\r",
									"/* Optional stricter checks — uncomment if your environment guarantees these fields\r",
									"pm.test('email is expected', () => {\r",
									"  pm.expect(json.data.email).to.eql(pm.environment.get('expectedUserEmail'));\r",
									"});\r",
									"\r",
									"pm.test('user has created_at timestamp', () => {\r",
									"  pm.expect(json.data).to.have.property('created_at');\r",
									"});\r",
									"*/"
