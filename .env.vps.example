# =============================================================================
# Digital Finance Tracker - VPS Production Environment
# PURPOSE: Template for VPS deployment (Docker PostgreSQL + Redis)
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this to .env.vps
# 2. Fill in all values marked with [REQUIRED]
# 3. Keep this file secure - never commit actual secrets
# =============================================================================

# =====================
# FLASK CONFIGURATION
# =====================
FLASK_APP=app:create_app
FLASK_ENV=production
FLASK_DEBUG=false

# [REQUIRED] SECURITY - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Pre-generated secure key (or generate your own):
SECRET_KEY=c1bedb4cd4a6ed9642d40b90d8ef9ac6f11fe32d5069f8553bc14b5ca30d1bb0

# CRITICAL: Keep this false in production!
DEV_IMPERSONATION=false

# =====================
# DATABASE (Docker PostgreSQL)
# =====================
# Database runs in Docker container on port 5433 (separate from existing 5432)
# Set a secure password here - it's used by docker-compose.prod.yaml
DB_PASSWORD=SecureFinance2026!

# DATABASE_URL is set automatically by docker-compose.prod.yaml
# Only uncomment if using external database:
# DATABASE_URL=postgresql://postgres:PASSWORD@hostname:5432/digital_finance

# =====================
# AUTH0 CONFIGURATION
# =====================
# [REQUIRED] Get from Auth0 Dashboard > Applications > Your API
AUTH0_DOMAIN=dev-2d371r8njde648mh.us.auth0.com
AUTH0_API_AUDIENCE=https://api.digitalfinance.local
AUTH0_ALGORITHMS=RS256

# =====================
# CORS CONFIGURATION
# =====================
# [REQUIRED] Your Vercel frontend URL - update after deploying to Vercel
# Example: https://digital-finance-abc123.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# =====================
# REDIS (Local Container)
# =====================
# Managed by docker-compose.prod.yaml - don't change unless customizing
REDIS_URL=redis://redis:6379/0

# =====================
# AI CONFIGURATION
# =====================
# All AI features enabled (VPS has enough RAM)
AI_CATEGORIZER_ENABLED=true
AI_INTENT_CLASSIFIER_ENABLED=true
AI_GUARDRAILS_ENABLED=true
AI_GEMINI_ENABLED=true
AI_MODEL_PATH=app/ai/model_store/
AI_CONFIDENCE_THRESHOLD=0.7

# [REQUIRED] Google Gemini API Key (fallback for low-confidence predictions)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyCYQVe_b4dJQCBANwzKjNewOwpgKYOR3X4

# =====================
# SERVER CONFIGURATION
# =====================
# Port 8003 to avoid conflicts with existing services on VPS
# (8000=MyHibachi Prod, 8002=MyHibachi Staging)
BACKEND_PORT=8003

# =====================
# LOGGING
# =====================
LOG_LEVEL=INFO
