DATABASE_NAME="digital_finance_db"
DATABASE_USER="postgres"
DATABASE_PASSWORD="postgres"

# Docker database connection (uses service name 'db')
DATABASE_URL=postgresql://postgres:postgres@db:5432/digital_finance_db

# Redis for Docker (uses service name 'redis' if available)
# REDIS_URL=redis://redis:6379/0

# Used inside docker-compose.yml for "ports:" mapping
FRONTEND_PORT=3000
BACKEND_PORT=8000
DATABASE_PORT=5432
ENVIRONMENT=development
REDIS_PORT=6379

# Dev impersonation for API testing (DO NOT enable in production!)
DEV_IMPERSONATION=true
