# =============================================================================
# Digital Finance Tracker - Backend Production Environment
# PURPOSE: Template for AWS Elastic Beanstalk / Production deployment
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this to .env.production
# 2. Fill in all values marked with [REQUIRED]
# 3. Set these as environment variables in AWS EB console
# =============================================================================

# =====================
# FLASK CONFIGURATION
# =====================
FLASK_APP=app:create_app
FLASK_ENV=production
FLASK_DEBUG=0
DEV_IMPERSONATION=false

# [REQUIRED] Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-production-secret-key-here

# =====================
# DATABASE (PostgreSQL)
# =====================
# [REQUIRED] AWS RDS PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@your-rds-instance.region.rds.amazonaws.com:5432/digital_finance_db

# =====================
# AUTH0 CONFIGURATION
# =====================
# [REQUIRED] Get from Auth0 Dashboard > Applications > Your API
AUTH0_DOMAIN=dev-2d371r8njde648mh.us.auth0.com
AUTH0_API_AUDIENCE=https://api.digitalfinance.local
AUTH0_ALGORITHMS=RS256

# =====================
# REDIS (OPTIONAL)
# =====================
# AWS ElastiCache Redis endpoint (optional but recommended for rate limiting)
# REDIS_URL=redis://your-elasticache-endpoint:6379/0

# =====================
# CORS CONFIGURATION
# =====================
# [REQUIRED] Your production frontend URL(s)
# For Vercel: https://your-app-name.vercel.app
# Multiple origins: comma-separated
FRONTEND_URL=https://your-app.vercel.app

# =====================
# AI CONFIGURATION
# =====================
AI_MODEL_PATH=app/ai/model_store/
AI_CONFIDENCE_THRESHOLD=0.7

# [REQUIRED] Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-production-gemini-api-key

# =====================
# MONITORING (OPTIONAL)
# =====================
# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# =====================
# LOGGING
# =====================
LOG_LEVEL=INFO
