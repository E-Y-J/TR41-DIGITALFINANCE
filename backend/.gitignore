# ============================================
# BACKEND .gitignore - Flask / Python
# Managed by Backend Team
# ============================================

# Personal/Local folders (NOT SHARED)
.local/
.local/logs/
.local/notes/
.local/scratch/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Environment variables
.env
.env.local
*.env

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Flask instance folder
instance/

# Celery
celerybeat-schedule
celerybeat.pid

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Mypy
.mypy_cache/
.dmypy.json
dmypy.json

# AI / ML model files (large files - use Git LFS if needed)
*.pkl
*.pickle
*.h5
*.hdf5
*.joblib
*.model
app/ai/model_store/*.pkl
app/ai/model_store/*.joblib

# Alembic
migrations/versions/__pycache__/

# Logs
*.log
logs/

# Database
*.db
*.sqlite3

# IDE
.idea/
.vscode/
*.swp
*.swo

# Sentry
.sentryclirc
