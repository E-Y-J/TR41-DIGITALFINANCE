# ============================================
# Backend Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env file!
# ============================================
# SECURITY WARNING: This file contains sensitive configuration
# Always use strong passwords and keep credentials secret
# ============================================

# Flask Configuration
FLASK_APP=app.main:create_app
FLASK_ENV=development   # Use 'production' in production
FLASK_DEBUG=1           # Set to 0 in production

# SECRET_KEY: Used for session signing and CSRF protection
# IMPORTANT: Generate a strong random key for production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# Database (PostgreSQL)
# Format: postgresql://username:password@host:port/database_name
# Replace 'username' and 'password' with your PostgreSQL credentials
DATABASE_URL=postgresql://username:password@localhost:5432/digital_finance_db

# Auth0 Configuration (REQUIRED for authentication)
# Get these from Auth0 Dashboard > Applications > Your API
# Steps:
#   1. Sign up at https://auth0.com (free tier available)
#   2. Create a new API in Auth0 Dashboard
#   3. Copy Domain, API Identifier, and keep RS256 algorithm
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=your-api-identifier
AUTH0_ALGORITHMS=RS256

# Redis (for caching & rate limiting)
# Optional: Comment out if Redis is not installed
# Install Redis: https://redis.io/download/
REDIS_URL=redis://localhost:6379/0

# Sentry (monitoring - optional)
# Sign up at https://sentry.io for error tracking
# Leave empty to disable
SENTRY_DSN=

# CORS (Frontend URL)
# Update this to match your frontend URL
# In production, use your actual frontend domain (e.g., https://yourapp.com)
FRONTEND_URL=http://localhost:5173

# AI Model Configuration
AI_MODEL_PATH=app/ai/model_store/
AI_CONFIDENCE_THRESHOLD=0.7

# PayPal Sandbox (Stretch Goal - not required for MVP)
# Uncomment and fill these if implementing PayPal integration
# Get credentials from: https://developer.paypal.com
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
